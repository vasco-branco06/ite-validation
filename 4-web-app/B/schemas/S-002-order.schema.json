{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "S-002",
  "title": "Order",
  "description": "A stored order as the list shows it. Used by R-003.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "customer_name", "phone", "cake", "pickup_date", "pickup_time", "picked_up", "created_at"],
  "properties": {
    "id": { "type": "integer", "minimum": 1, "description": "Database row id" },
    "customer_name": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "phone": { "type": "string", "pattern": "^[0-9 +]*[0-9][0-9 +]*$" },
    "cake": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "pickup_date": { "type": "string", "format": "date" },
    "pickup_time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "picked_up": { "type": "boolean", "description": "True after Picked up is clicked" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
